# Copy outside the repository and customize for the target environment.
# Never commit the rendered private environment file.

ENVIRONMENT=lab

OPENSEARCH_CLUSTER_NAME=observability-lab
OPENSEARCH_NODE_NAME=observability-node-1
OPENSEARCH_BIND_ADDRESS=0.0.0.0
OPENSEARCH_HEAP_SIZE=2g
OPENSEARCH_NODE_DN=CN=observability-node-1,OU=Observability,O=Example,L=Lab,C=ZZ
OPENSEARCH_ADMIN_DN=CN=observability-admin,OU=Observability,O=Example,L=Lab,C=ZZ
OPENSEARCH_HTTPS_ENDPOINT=https://localhost:9200
OPENSEARCH_CA_CERTIFICATE=/opt/opensearch/config/certs/root-ca.pem

DASHBOARDS_SERVER_NAME=observability-dashboards
DASHBOARDS_BIND_ADDRESS=0.0.0.0
DASHBOARDS_SERVICE_USERNAME=kibanaserver
DASHBOARDS_SERVICE_PASSWORD_FILE=/run/secrets/opensearch_dashboards_password
DASHBOARDS_ADMIN_USERNAME=admin

OPENSEARCH_INGEST_USERNAME=data-prepper-ingest
OPENSEARCH_INGEST_PASSWORD_FILE=/run/secrets/data_prepper_ingest_password
DATA_PREPPER_CA_CERTIFICATE=/etc/data-prepper/certs/root-ca.pem

ALERTMANAGER_TELEGRAM_CHAT_ID=123456789
ALERTMANAGER_TELEGRAM_TOKEN_FILE=/etc/alertmanager/secrets/telegram_bot_token

KUBELET_BEARER_TOKEN_FILE=/run/secrets/kubelet_bearer_token
