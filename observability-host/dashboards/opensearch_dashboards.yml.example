server.port: 5601
server.host: "{{ DASHBOARDS_BIND_ADDRESS }}"
server.name: "{{ DASHBOARDS_SERVER_NAME }}"

opensearch.hosts: ["{{ OPENSEARCH_HTTPS_ENDPOINT }}"]
opensearch.ssl.verificationMode: full
opensearch_security.enabled: true
data.search.usageTelemetry.enabled: false

workspace.enabled: true
data_source.enabled: true
explore.enabled: true
explore.discoverTraces.enabled: true
explore.discoverMetrics.enabled: true
datasetManagement.enabled: true

opensearch.ssl.certificateAuthorities: ["{{ OPENSEARCH_CA_CERTIFICATE }}"]
opensearch.username: "{{ DASHBOARDS_SERVICE_USERNAME }}"
opensearch.password: "{{ DASHBOARDS_SERVICE_PASSWORD }}"
opensearch.requestHeadersAllowlist: ["authorization"]

opensearch_security.multitenancy.enabled: false
opensearch_security.cookie.secure: false
savedObjects.permission.enabled: true
opensearchDashboards.dashboardAdmin.users: ["{{ DASHBOARDS_ADMIN_USERNAME }}"]
