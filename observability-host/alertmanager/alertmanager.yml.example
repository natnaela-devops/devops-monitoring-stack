global:
  resolve_timeout: 5m

templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  receiver: telegram-observability

  group_by:
    - alertname
    - severity
    - environment

  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: telegram-observability
    telegram_configs:
      - bot_token_file: "{{ ALERTMANAGER_TELEGRAM_TOKEN_FILE }}"
        chat_id: {{ ALERTMANAGER_TELEGRAM_CHAT_ID }}
        send_resolved: true
        parse_mode: ''
        message: '{{ template "telegram.observability.message" . }}'

# Higher-severity alerts suppress the corresponding lower-severity
# notification for the same affected resource. Prometheus continues
# evaluating both rules; this controls notification noise only.
inhibit_rules:

  - source_matchers:
      - 'alertname="NodeDiskUsageCritical"'
    target_matchers:
      - 'alertname="NodeDiskUsageHigh"'
    equal:
      - environment
      - node
      - mountpoint

  - source_matchers:
      - 'alertname="NodeCPUUsageCritical"'
    target_matchers:
      - 'alertname="NodeCPUUsageHigh"'
    equal:
      - environment
      - node

  - source_matchers:
      - 'alertname="NodeMemoryUsageCritical"'
    target_matchers:
      - 'alertname="NodeMemoryUsageHigh"'
    equal:
      - environment
      - node

  - source_matchers:
      - 'alertname="ApplicationP99LatencyCritical"'
    target_matchers:
      - 'alertname="ApplicationP99LatencyHigh"'
    equal:
      - environment
      - service
