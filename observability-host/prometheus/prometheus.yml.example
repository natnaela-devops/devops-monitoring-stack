global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    environment: "{{ ENVIRONMENT }}"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - 127.0.0.1:9093

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

{{ NODE_EXPORTER_JOB_BLOCK }}
{{ KUBE_STATE_METRICS_JOB_BLOCK }}
{{ KUBELET_CADVISOR_JOB_BLOCK }}

  - job_name: process-exporter
    static_configs:
      - targets: ['127.0.0.1:9256']
        labels:
          node: "{{ OBSERVABILITY_NODE_LABEL }}"
          ip: "{{ OBSERVABILITY_NODE_IP }}"
          role: observability
