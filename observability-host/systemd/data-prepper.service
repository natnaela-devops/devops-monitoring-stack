[Unit]
Description=OpenSearch Data Prepper
Documentation=https://docs.opensearch.org/latest/data-prepper/
Wants=network-online.target
After=network-online.target opensearch.service
Requires=opensearch.service

[Service]
Type=simple
User=data-prepper
Group=data-prepper
WorkingDirectory=/opt/data-prepper-2.14.1
Environment="JAVA_OPTS=-Xms512m -Xmx1g"
ExecStart=/opt/data-prepper-2.14.1/bin/data-prepper /etc/data-prepper/pipelines/pipelines.yaml /etc/data-prepper/data-prepper-config.yaml
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/data-prepper /var/log/data-prepper

[Install]
WantedBy=multi-user.target
