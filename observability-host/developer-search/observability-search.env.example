# Developer Observability Search runtime identity
OBSERVABILITY_ENVIRONMENT=uat2
OBSERVABILITY_ENV_LABEL=UAT2

# Browser-facing redirects; localhost is intentional when operators use SSH local forwarding.
DASHBOARDS_BASE=http://localhost:5601

# Backend OpenSearch connection
OPENSEARCH_URL=https://127.0.0.1:9200
OPENSEARCH_USERNAME=trace-lookup-reader
OPENSEARCH_CA=/etc/observability-search/root-ca.pem
